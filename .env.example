# .env.example — copy to .env and fill in
# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# LLM (LiteLLM proxy or direct provider)
LLM_API_BASE=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Cloudflare Workers
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_WORKERS_ZONE_ID=

# NHTSA (free, no key needed but kept for extensibility)
NHTSA_BASE=https://vpic.nhtsa.dot.gov/api

# Website webhook
WEBSITE_WEBHOOK_URL=
WEBSITE_WEBHOOK_SECRET=

# Shop system API (Tekmetric/Shopmonkey auto-detect)
SHOP_API_BASE=
SHOP_API_KEY=

# Parts supplier
PARTS_SUPPLIER_EMAIL=
