# .env.example — Next Level Auto (CLOUD-NATIVE — zero local compute)
# Your ThinkPad only needs a browser. Everything runs in free cloud tiers.
# Copy to .env and fill in the values.

# =============================================================================
# LLM — Cloud-based (no local compute needed)
# =============================================================================
# Option 1: OpenRouter (easiest free tier — sign up at https://openrouter.ai)
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Option 2: Together AI (free credits — sign up at https://together.xyz)
TOGETHER_API_KEY=REPLACE_WITH_TOGETHER_KEY

# Option 3: Groq (free tier, very fast — sign up at https://console.groq.com)
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY

# Choose one above. LiteLLM handles the routing.
LITELLM_URL=https://openrouter.ai/api/v1
LITELLM_KEY=${OPENROUTER_API_KEY}
LITELLM_MODEL=openrouter/google/gemma-2-9b-it:free

# =============================================================================
# SUPABASE (cloud free tier — sign up at https://supabase.com)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_KEY
SUPABASE_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
SUPABASE_DB_HOST=db.YOUR_PROJECT.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# =============================================================================
# TELEGRAM (free — create bot via @BotFather)
# =============================================================================
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
TELEGRAM_ADMIN_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# =============================================================================
# STRIPE (test mode — no real charges)
# =============================================================================
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE
STRIPE_SUCCESS_URL=https://YOUR_DOMAIN/subscriptions/success
STRIPE_CANCEL_URL=https://YOUR_DOMAIN/subscriptions/cancel

# =============================================================================
# TWILIO (optional — free trial, for SMS notifications)
# =============================================================================
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_NUMBER

# =============================================================================
# SLACK (optional — for P1 notifications)
# =============================================================================
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK

# =============================================================================
# DEPLOYMENT
# =============================================================================
VERCEL_PROJECT=nextlevelauto
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CF_ACCOUNT
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CF_TOKEN
CLOUDFLARE_ZONE_ID=REPLACE_WITH_CF_ZONE

# =============================================================================
# APP
# =============================================================================
TEST_MODE=true
NODE_ENV=development
DOMAIN=https://YOUR_DOMAIN
LOG_LEVEL=info
COST_DAILY_BUDGET_USD=5.00
RECONCILER_ENABLED=true
RECONCILER_CRON=0 2 * * *
